# /etc/portal/cs2-poller.env — seeded from this example on install; the
# Ansible portal_steam_bot role overwrites it from the vault on deploy.
#
# cs2-poller needs NO Steam account — it uses the Steam Web API only.

# Portal API (co-hosted → loopback). Note the /v1 suffix.
PORTAL_API_URL=http://127.0.0.1:3000/v1
PORTAL_API_KEY=CHANGE_ME

# Steam Web API key (same key the portal uses for persona lookups).
STEAM_WEB_API_KEY=CHANGE_ME

POLL_INTERVAL_SECS=60
GAME_SLUG=cs2

RUST_LOG=cs2_poller=info
