[Unit]
Description=One-shot Steam mobile authenticator linker (driven via the guard page)
Documentation=https://github.com/community-gaming/gaming-portal
After=network-online.target
Wants=network-online.target
# Frees GUARD_ADDR (the code-entry port, so the SAME ts.net:8443 page URL
# serves the linking flow) and prevents two concurrent Steam logins on the
# bot account.
Conflicts=cs2-enricher.service
After=cs2-enricher.service
# Only FAILURE brings the enricher back automatically: a failed link changed
# nothing about the account, so resuming enrichment is safe.
#
# Success deliberately leaves the enricher DOWN. A fresh authenticator means
# Steam now demands a TOTP device code, and the secret to answer it has only
# just been minted — it cannot be in the vault yet. Restarting here puts the
# bot into a login loop it cannot win, and those attempts throttle the
# account (RateLimitExceeded → AccountLoginDeniedThrottle), which costs far
# more downtime than the manual start does. Start it after deploying the
# secret; the run's final notice says so.
OnFailure=cs2-enricher.service

[Service]
# Started MANUALLY (systemctl start steam-guard-link) — no [Install]
# section on purpose; this must never run unattended at boot.
Type=exec
User=portal
Group=portal
WorkingDirectory=/var/lib/portal
# Reuses the enricher's credentials and GUARD_ADDR.
EnvironmentFile=/etc/portal/cs2-enricher.env
# NO machine-token cache here, deliberately. This tool no longer logs in
# over the CM: it needs a mobile-platform session for AddAuthenticator, so
# it runs its own WebAPI login (see mobile.rs) and never touches
# steam-vent's FileGuardDataStore. It therefore cannot seed the enricher's
# token, and pointing XDG_CACHE_HOME here would only imply otherwise. The
# enricher answers its own guard challenge with the TOTP secret this run
# produces.
Environment=HOME=/var/lib/portal
# The <account>.maFile (shared secret + revocation code, mode 0600) lands
# here. Copy the shared secret into the vault after a successful run.
StateDirectory=portal-steam-bot
Environment=MAFILE_DIR=/var/lib/portal-steam-bot

ExecStart=/usr/bin/steam-guard-link

# Abandoned runs must not hold a Steam session (or the page port) forever.
RuntimeMaxSec=2h
Restart=no
TimeoutStopSec=30s

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

StandardOutput=journal
StandardError=journal
SyslogIdentifier=steam-guard-link
