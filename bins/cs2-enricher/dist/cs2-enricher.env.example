# /etc/portal/cs2-enricher.env — seeded from this example on install; the
# Ansible portal_steam_bot role overwrites it from the vault on deploy.
#
# cs2-enricher logs into the CS2 Game Coordinator, so it REQUIRES a
# dedicated Steam bot account (CS2 in library, ideally Prime) — never a
# personal account.

# Portal API (co-hosted → loopback). Note the /v1 suffix.
PORTAL_API_URL=http://127.0.0.1:3000/v1
PORTAL_API_KEY=CHANGE_ME

# Dedicated Steam bot account.
STEAM_USERNAME=CHANGE_ME
STEAM_PASSWORD=CHANGE_ME
# Steam Guard TOTP shared secret (base64) for unattended 2FA login.
STEAM_SHARED_SECRET=CHANGE_ME

BATCH_SIZE=5
ENRICH_INTERVAL_SECS=30
GAME_SLUG=cs2
# Set true to skip demo download + rank extraction (GC scoreboard only).
SKIP_DEMO_RANK=false

RUST_LOG=cs2_enricher=info
