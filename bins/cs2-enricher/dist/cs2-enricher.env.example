# /etc/portal/cs2-enricher.env — seeded from this example on install; the
# Ansible portal_steam_bot role overwrites it from the vault on deploy.
#
# cs2-enricher logs into the CS2 Game Coordinator, so it REQUIRES a
# dedicated Steam bot account (CS2 in library, ideally Prime) — never a
# personal account.

# Portal API (co-hosted → loopback). Note the /v1 suffix.
PORTAL_API_URL=http://127.0.0.1:3000/v1
PORTAL_API_KEY=CHANGE_ME

# Dedicated Steam bot account.
STEAM_USERNAME=CHANGE_ME
STEAM_PASSWORD=CHANGE_ME
# Steam Guard TOTP shared secret (base64) for unattended 2FA login.
STEAM_SHARED_SECRET=CHANGE_ME

BATCH_SIZE=5
ENRICH_INTERVAL_SECS=30
GAME_SLUG=cs2
# Set true to skip demo download + rank extraction (GC scoreboard only).
SKIP_DEMO_RANK=false

# Loopback Prometheus /metrics + /healthz (never public; empty/unset =
# disabled). The portal box uses 9468 (deploy docs: observability-design.md §3).
#METRICS_ADDR=127.0.0.1:9468

# Loopback Steam Guard code-entry page (empty/unset = disabled). Used when
# no STEAM_SHARED_SECRET is set and the stored machine token can't satisfy
# a login: the bot parks and this page accepts the emailed/TOTP code.
# Never public — reach it via Tailscale Serve on the box's ts.net name
# (deploy: roles/portal_steam_bot) or an SSH tunnel. Portal box uses 9478.
# The same page also drives `systemctl start steam-guard-link`, the
# one-shot mobile-authenticator bootstrap that mints STEAM_SHARED_SECRET.
#GUARD_ADDR=127.0.0.1:9478

RUST_LOG=cs2_enricher=info
